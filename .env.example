# Démarrage : node --env-file=.env src/api/server.ts
# Mode local, comptes fictifs. Les phrases natifs non relues sont activées et marquées « Brouillon ».
CT_ALLOW_DRAFT=1

# Connexion du middleware (/safinum/middleware) au bac à sable officiel.
# CT_BACKEND=safinum
# CT_SAFINUM_URL=https://safinum.cm/api/v1
# CT_SAFINUM_KEY=
# CT_SAFINUM_WEBHOOK_KEY=  # uniquement si SAFINUM envoie ce secret dans X-Team-Key

# Fournisseurs facultatifs. Le texte reste disponible même sans modèles.
# CT_MT_AUTOSTART=0
# CT_MT_URL=http://127.0.0.1:8091
# CT_ASR_LLM_URL=http://127.0.0.1:8092  # option : Meta Omnilingual ASR avec langue indiquée
# CT_ASR_MODEL=sherpa-onnx-omnilingual-asr-1600-languages-300M-ctc-int8-2025-11-12
# CT_PLOTWEAVER_KEY=
# CT_PLOTWEAVER_LANG_FUB=  # code de langue indiqué par votre accès PlotWeaver
# CT_PLOTWEAVER_LANG_EWO=
